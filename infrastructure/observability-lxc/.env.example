# infrastructure/observability-lxc/.env.example
# Copy to .env (gitignored) inside CT405, set the value, then `docker compose up -d`.
# For the repo, keep the real value in a SOPS .env.enc.yaml (sops -d .env.enc.yaml > .env).

# Grafana admin password. If unset, Grafana starts with admin/admin and forces a
# change on first login — set this to skip that.
GRAFANA_ADMIN_PASSWORD=

# Gotify application tokens, one per Grafana alert category (see
# grafana/provisioning/alerting/contactpoints.yaml for the app names and priorities).
GOTIFY_TOKEN_CRITICAL=
GOTIFY_TOKEN_SECURITY=
GOTIFY_TOKEN_KUBERNETES=
GOTIFY_TOKEN_NETWORK=
GOTIFY_TOKEN_INFRA=

# OPNsense API key + secret for the opnsense-exporter service (read-only API user,
# see README "OPNsense exporter"). Download the key file from System > Access > Users.
OPNSENSE_API_KEY=
OPNSENSE_API_SECRET=
