        "query": {
          "query": "label_values(opnsense_filterlog_entries_total, iface)",
          "refId": "v"
        },
        "definition": "label_values(opnsense_filterlog_entries_total, iface)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "sort": 1,
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "allValue": ".*"
      },
      {
        "name": "action",
        "label": "Action (rule/log panels)",
        "type": "custom",
        "query": "block,nat,pass",
        "multi": false,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "All"
        },
        "options": [
          {
            "text": "All",
            "value": "$__all",
            "selected": true
          },
          {
            "text": "block",
            "value": "block",
            "selected": false
          },
          {
            "text": "nat",
            "value": "nat",
            "selected": false
          },
          {
            "text": "pass",
            "value": "pass",
            "selected": false
          }
        ]
      },
      {
        "name": "ip",
        "label": "IP filter (regex)",
        "type": "textbox",
        "query": "",
        "current": {
          "text": "",
          "value": ""
        }
      }
    ]
  },
