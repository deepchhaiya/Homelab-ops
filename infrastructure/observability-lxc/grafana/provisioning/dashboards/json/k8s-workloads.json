      },
      "transformations": [
        {
          "id": "merge",
          "options": {
          }
        },
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "Value #A": true,
              "Value #B": true,
              "Value #C": true,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "renameByName": {
              "pod": "Pod",
              "container": "Container",
              "image": "Image",
              "reason": "Waiting",
              "last_reason": "Last terminated"
            }
          }
        }
      ],
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (pod, container, image) (kube_pod_container_info{namespace=\"$namespace\", pod=~\"$pod\", container=~\"$container\"})",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (pod, container, reason) (kube_pod_container_status_waiting_reason{namespace=\"$namespace\", pod=~\"$pod\"} == 1)",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "prometheus",
            "uid": "victoriametrics"
          },
          "expr": "max by (pod, container, reason) (label_replace(kube_pod_container_status_last_terminated_reason{namespace=\"$namespace\", pod=~\"$pod\"} == 1, \"last_reason\", \"$1\", \"reason\", \"(.*)\"))",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "id": 3,
      "gridPos": {
        "h": 6,
        "w": 24,
        "x": 0,
        "y": 8
