// Grafana Alloy — ship this LXC's Docker container logs to Loki.
discovery.docker "containers" {
  host = "unix:///var/run/docker.sock"
}

// Use the container name (strip the leading "/") as the `container` label.
discovery.relabel "containers" {
  targets = discovery.docker.containers.targets
  rule {
    source_labels = ["__meta_docker_container_name"]
    regex         = "/(.*)"
    target_label  = "container"
  }
}

loki.source.docker "default" {
  host       = "unix:///var/run/docker.sock"
  targets    = discovery.relabel.containers.output
  forward_to = [loki.write.local.receiver]
}

// ── OPNsense general syslog: filter, firewall, hostwatch, monit, suricata, wireguard ──
loki.source.syslog "network" {
  listener {
    address                = "0.0.0.0:1514"
    protocol               = "tcp"
    syslog_format          = "rfc5424"
    labels                 = { job = "opnsense", source = "syslog", host = "opnsense" }
    use_incoming_timestamp = true
    max_message_length     = 32768   // Suricata EVE JSON blows past the 8192 default
  }
  // Must run here, not in a downstream loki.relabel: the source strips every
  // __-prefixed label (incl. __syslog_message_app_name) before forwarding.
  relabel_rules = loki.relabel.opnsense_program.rules
  forward_to    = [loki.process.opnsense.receiver]
}

// Promote the syslog program name to a stream label — 6 values, safe cardinality.
// Used only as relabel_rules above, so it forwards nowhere itself.
loki.relabel "opnsense_program" {
  forward_to = []
  rule {
    source_labels = ["__syslog_message_app_name"]
    target_label  = "program"
  }
}

loki.process "opnsense" {
  // ── filterlog (pf) — CSV. Fields 1-9 are fixed for IPv4 and IPv6; after field 9 the
  // layouts differ, so there is one regex per IP version (a non-matching stage.regex is a
  // no-op). Field map (OPNsense filterlog format):
  //   1 rule nr, 4 tracker (rule id — the same id the Firewall › Log Files › Live View
  //   "rule" link uses), 5 iface, 6 reason, 7 action, 8 dir, 9 ipversion
  //   v4: 17 protoname, 19 src, 20 dst, 21 sport, 22 dport (tcp/udp only)
  //   v6: 13 protoname, 16 src, 17 dst, 18 sport, 19 dport (tcp/udp only)
  stage.match {
    selector = "{program=\"filterlog\"}"
    stage.regex {
      expression = `^(?P<rule>[^,]*),[^,]*,[^,]*,(?P<tracker>[^,]*),(?P<iface>[^,]*),(?P<reason>[^,]*),(?P<action>[^,]*),(?P<dir>[^,]*),(?P<ipversion>4),(?:[^,]*,){7}(?P<proto>[^,]*),[^,]*,(?P<src_ip>[^,]*),(?P<dst_ip>[^,]*)(?:,(?P<src_port>\d+),(?P<dst_port>\d+))?`
    }
    stage.regex {
      expression = `^(?P<rule>[^,]*),[^,]*,[^,]*,(?P<tracker>[^,]*),(?P<iface>[^,]*),(?P<reason>[^,]*),(?P<action>[^,]*),(?P<dir>[^,]*),(?P<ipversion>6),(?:[^,]*,){3}(?P<proto>[^,]*),[^,]*,[^,]*,(?P<src_ip>[^,]*),(?P<dst_ip>[^,]*)(?:,(?P<src_port>\d+),(?P<dst_port>\d+))?`
    }

    // Log-derived counter -> Alloy /metrics -> VictoriaMetrics (job alloy-observability).
    // Labels are promoted only long enough for stage.metrics to read them, then dropped,
    // so Loki streams stay as they were (IPs/ports/rule stay structured metadata).
    // Exposed as opnsense_filterlog_entries_total{action,iface,dir,proto,ipversion}.
    stage.labels {
      values = { action = "", iface = "", dir = "", proto = "", ipversion = "" }
    }
    stage.metrics {
      metric.counter {
        name        = "filterlog_entries_total"
        prefix      = "opnsense_"
        description = "OPNsense filterlog entries by action/interface/direction/protocol."
        match_all   = true
        action      = "inc"
      }
    }
    stage.label_drop {
      values = ["action", "iface", "dir", "proto", "ipversion"]
    }

    stage.structured_metadata {
      values = { iface = "", reason = "", action = "", dir = "", ipversion = "",
                 rule = "", tracker = "", proto = "",
                 src_ip = "", dst_ip = "", src_port = "", dst_port = "" }
    }
  }

  // ── Suricata EVE-over-syslog is pure JSON ──
  stage.match {
    selector = "{program=\"suricata\"} |~ \"^\\\\{\""
    stage.json {
      expressions = {
        alert_signature = "alert.signature",
        alert_sid       = "alert.signature_id",
        alert_severity  = "alert.severity",
        src_ip          = "src_ip",
        dest_ip         = "dest_ip",
        dest_port       = "dest_port",
        app_proto       = "app_proto",
      }
    }
    stage.structured_metadata {
      values = { alert_signature = "", alert_sid = "", alert_severity = "",
                 src_ip = "", dest_ip = "", dest_port = "", app_proto = "" }
    }
    // opnsense_suricata_alerts_total{alert_severity} — alerts only, not flow/stats events
    stage.match {
      selector = "{program=\"suricata\"} |= \"\\\"event_type\\\":\\\"alert\\\"\""
      stage.labels {
        values = { alert_severity = "" }
      }
      stage.metrics {
        metric.counter {
          name        = "suricata_alerts_total"
          prefix      = "opnsense_"
          description = "Suricata IDS alerts by severity."
          match_all   = true
          action      = "inc"
        }
      }
      stage.label_drop {
        values = ["alert_severity"]
      }
    }
  }

  // ── hostwatch: "new station host <mac> using <ip> at <iface>" = a device/address
  // appeared on a LAN segment. Counter + metadata for the "new devices" panels.
  stage.match {
    selector = "{program=\"hostwatch\"} |= \"new station\""
    stage.regex {
      expression = `new station host (?P<mac>\S+) using (?P<host_ip>\S+) at (?P<iface>\S+)`
    }
    stage.structured_metadata {
      values = { mac = "", host_ip = "", iface = "" }
    }
    stage.labels {
      values = { iface = "" }
    }
    stage.metrics {
      metric.counter {
        name        = "hostwatch_new_stations_total"
        prefix      = "opnsense_"
        description = "hostwatch new station (MAC/IP pair) sightings by interface."
        match_all   = true
        action      = "inc"
      }
    }
    stage.label_drop {
      values = ["iface"]
    }
  }

  // ── dnsmasq DHCP: "DHCPACK(igb0) 192.168.4.28 aa:bb:cc:dd:ee:ff hostname".
  // DISCOVER lines have no IP and some have no hostname, hence the optional groups.
  // Counter opnsense_dhcp_messages_total{dhcp_msg, iface}; lease details = metadata.
  stage.match {
    selector = "{program=~\"dnsmasq.*\"} |~ \"DHCP[A-Z]+\\\\(\""
    stage.regex {
      expression = `(?P<dhcp_msg>DHCP[A-Z]+)\((?P<iface>[^)]+)\)(?: (?P<host_ip>[0-9.]+))?(?: (?P<mac>[0-9a-fA-F]{2}(?::[0-9a-fA-F]{2}){5}))?(?: (?P<hostname>\S+))?`
    }
    stage.structured_metadata {
      values = { dhcp_msg = "", iface = "", host_ip = "", mac = "", hostname = "" }
    }
    stage.labels {
      values = { dhcp_msg = "", iface = "" }
    }
    stage.metrics {
      metric.counter {
        name        = "dhcp_messages_total"
        prefix      = "opnsense_"
        description = "dnsmasq DHCP messages by type and interface."
        match_all   = true
        action      = "inc"
      }
    }
    stage.label_drop {
      values = ["dhcp_msg", "iface"]
    }
  }

  // Everything else (wireguard, audit, configd, dpinger, ...) passes through with only
  // the program label — enable those apps under System › Settings › Logging › Remote.
  forward_to = [loki.write.local.receiver]
}

// ── OPNsense Unbound per-query replies (resolver target) -> Loki, 90d stream ──
// Needs Unbound Advanced: "Log Replies" + "Tag Queries and Replies" on.
loki.source.syslog "opnsense_dns" {
  listener {
    address                = "0.0.0.0:1515"
    protocol               = "tcp"
    syslog_format          = "rfc5424"
    labels                 = { job = "opnsense_dns", source = "unbound", host = "opnsense" }
    use_incoming_timestamp = true
  }
  forward_to = [loki.process.dns.receiver]
}

loki.process "dns" {
  // keep only reply lines; drop unbound's startup/notice chatter
  stage.match {
    selector            = "{job=\"opnsense_dns\"} !~ \"reply: \""
    action              = "drop"
    drop_counter_reason = "not_a_dns_reply"
  }

  // reply: <client> <qname> <type> <class> <rcode> <secs> <cached 0|1> <pktlen>
  stage.regex {
    expression = "reply: (?P<client>\\S+) (?P<qname>\\S+) (?P<qtype>\\S+) (?P<qclass>\\S+) (?P<rcode>\\S+) (?P<resolve_s>[0-9.]+) (?P<cached>[01]) (?P<size>\\d+)"
  }

  // structured metadata, NOT labels — client/qname as labels would shatter the index.
  // "qname", not "domain": domain is already a stream label (NPM pipeline).
  stage.structured_metadata {
    values = { client = "", qname = "", qtype = "", rcode = "", cached = "" }
  }

  // opnsense_dns_replies_total{rcode,cached} -> VictoriaMetrics (NXDOMAIN/SERVFAIL rates,
  // cache hit ratio from the logs). Labels promoted only for the counter, then dropped.
  stage.labels {
    values = { rcode = "", cached = "" }
  }
  stage.metrics {
    metric.counter {
      name        = "dns_replies_total"
      prefix      = "opnsense_"
      description = "Unbound replies by rcode and cache hit."
      match_all   = true
      action      = "inc"
    }
  }
  stage.label_drop {
    values = ["rcode", "cached"]
  }
  forward_to = [loki.write.local.receiver]
}

loki.write "local" {
  endpoint {
    url = "http://loki:3100/loki/api/v1/push"
  }
}
