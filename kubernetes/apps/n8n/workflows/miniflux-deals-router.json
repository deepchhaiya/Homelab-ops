    {
      "id": "8af2fdc1-b976-4a74-8f3a-2ac66def8765",
      "name": "Mark read",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1792,
        80
      ],
      "parameters": {
        "method": "PUT",
        "url": "https://miniflux.dkghar.duckdns.org/v1/entries",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ entry_ids: $('Prep routing').all().map((i) => i.json.entry_id), status: 'read' }) }}",
        "options": {
          "timeout": 30000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "Qx6lZBonRv10MLcT",
          "name": "Miniflux Token"
        }
      },
      "executeOnce": true,
      "onError": "continueRegularOutput"
    },
    {
      "id": "9b6a8cc0-20c1-41d0-a8be-c2ed4e3dc2d0",
      "name": "Batch deals",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        780,
        -40
      ],
      "parameters": {
        "jsCode": "// Group fresh deals into batches of 30 - a skimmable list per notification, each\n// line a markdown link so the title reads plainly and the URL stays tappable.\n// Newest first, so the top of the list is the freshest thing in the batch.\nconst BATCH = 30;\nconst items = $input.all().map((i) => i.json).filter((d) => d && d.url)\n  .sort((a, b) => new Date(b.published_at || 0) - new Date(a.published_at || 0));\nif (!items.length) return [];\n\nconst total = Math.ceil(items.length / BATCH);\nconst out = [];\n\nfor (let i = 0; i < items.length; i += BATCH) {\n  const chunk = items.slice(i, i + BATCH);\n  const index = Math.floor(i / BATCH) + 1;\n  const lines = chunk.map((d, n) => {\n    // Square brackets in a deal title would break the markdown link syntax.\n    const safe = String(d.title || 'Untitled').replace(/[\\[\\]]/g, '').trim();\n    return `${i + n + 1}. [${safe}](${d.url})`;\n  });\n  out.push({\n    json: {\n      batch_index: index,\n      batch_total: total,\n      count: chunk.length,\n      entry_ids: chunk.map((d) => d.entry_id),\n      title: `🛒 ${chunk.length} new deal${chunk.length === 1 ? '' : 's'}${total > 1 ? ` (${index}/${total})` : ''}`,\n      message: lines.join('\\n'),\n    },\n  });\n}\n\nconsole.log('deal batches: ' + out.length + ' message(s) for ' + items.length + ' fresh deals');\nreturn out;"
      }
    }
  ],
