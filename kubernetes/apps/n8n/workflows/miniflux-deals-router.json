    {
      "id": "6ad1d681-82ec-4266-8f75-969004f268ee",
      "name": "Plan deal scan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        80
      ],
      "parameters": {
        "jsCode": "// Deals and Firehose only - miniflux-curator deliberately skips these so its LLM\n// budget goes to real news. Firehose (unfiltered HN, llama.cpp releases) is drained\n// silently; deals are delivered to the deal Gotify apps.\n//\n// limit 150 per category is headroom, not a target: normal intake is ~35 fresh deals\n// per 2-hourly run. The headroom means a missed or failed run is caught up by the\n// next one instead of silently ageing out of the 12h notify window.\nconst INCLUDE = /deal|slickdeal|firehose/i;\nconst cats = $input.all().map((i) => i.json).filter((c) => c && c.id && INCLUDE.test(c.title || ''));\nreturn cats.map((c) => ({\n  json: {\n    category_id: c.id,\n    category_title: c.title,\n    limit: 150,\n    silent: /firehose/i.test(c.title),\n  },\n}));"
      }
    },
    {
      "id": "1a7716e0-60cc-4602-bcbc-ced2be9880e6",
      "name": "Fetch unread",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        672,
        80
      ],
      "parameters": {
        "url": "=https://miniflux.dkghar.duckdns.org/v1/entries?status=unread&direction=desc&limit={{ $json.limit }}&category_id={{ $json.category_id }}",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "timeout": 20000
        }
      },
      "credentials": {
        "httpHeaderAuth": {
          "id": "Qx6lZBonRv10MLcT",
          "name": "Miniflux Token"
        }
      },
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "id": "5cff83d9-8000-428c-b3ae-a2869ca6895a",
      "name": "Prep routing",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        896,
        80
      ],
      "parameters": {
        "jsCode": "// One item per entry.\n//\n// FRESH_HOURS is the notify window: a deal delivered late is worthless, so anything\n// older is marked read SILENTLY rather than pushed. 12h (not 24h) so deals that\n// appear overnight still arrive with the 07:00 run, but yesterday's do not.\n// The same path drains the ~4,800-entry stale backlog without notifying.\n// Firehose entries are always silent.\nconst FRESH_HOURS = 12;\nconst cutoff = Date.now() - FRESH_HOURS * 3600 * 1000;\nconst out = [];\nconst seen = new Set();\n\n$input.all().forEach((item) => {\n  const plan = item.json || {};\n  const arr = Array.isArray(plan.entries) ? plan.entries : [];\n  arr.forEach((e) => {\n    if (!e || !e.id || seen.has(e.id)) return;\n    seen.add(e.id);\n    const cat = (e.feed && e.feed.category && e.feed.category.title) || '';\n    const feed = (e.feed && e.feed.title) || '';\n    const isFirehose = /firehose/i.test(cat);\n    const published = new Date(e.published_at || 0).getTime();\n    const stale = !published || published < cutoff;\n    out.push({\n      json: {\n        entry_id: e.id,\n        title: String(e.title || '').slice(0, 120),\n        url: e.url,\n        feed,\n        category: cat,\n        published_at: e.published_at || '',\n        silent: isFirehose || stale,\n        message: String(e.title || '') + '\\n\\n' + String(e.url || ''),\n      },\n    });\n  });\n});\n\nconst notify = out.filter((o) => !o.json.silent).length;\nconsole.log('deal router: ' + out.length + ' entries, ' + notify + ' to notify, ' + (out.length - notify) + ' silent (older than ' + FRESH_HOURS + 'h or firehose)');\nreturn out;"
      }
    },
    {
      "id": "8fe001f1-cca9-4dad-8078-d08817977531",
      "name": "Notify or drain",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3,
      "position": [
        1120,
        80
      ],
      "parameters": {
        "rules": {
          "values": [
            {
              "outputKey": "notify",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.silent }}",
                    "operator": {
                      "type": "boolean",
                      "operation": "false",
                      "singleValue": true
                    }
                  }
                ],
                "combinator": "and"
              }
            },
            {
              "outputKey": "silent",
              "conditions": {
                "options": {
                  "caseSensitive": true,
                  "leftValue": "",
                  "typeValidation": "loose"
                },
                "conditions": [
                  {
                    "leftValue": "={{ $json.silent }}",
                    "operator": {
                      "type": "boolean",
                      "operation": "true",
                      "singleValue": true
                    }
                  }
                ],
                "combinator": "and"
              }
            }
          ]
        },
        "options": {
          "fallbackOutput": "none"
        }
      }
    },
