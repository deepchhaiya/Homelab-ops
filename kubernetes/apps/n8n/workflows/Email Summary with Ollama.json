    {
      "parameters": {
        "jsCode": "const items = $input.all().map((i) => i.json);\n\nfunction emoji(score) {\n  if (score >= 8) return '🔴';\n  if (score >= 6) return '🟠';\n  return '🟡';\n}\n\nconst blocks = items.map((e) => {\n  const tag = e.urgent ? ' · URGENT' : '';\n  return `${emoji(e.score)} ${e.score}/10 · ${e.category}${tag}\\n${e.subject}\\nFrom: ${e.from}\\n${e.summary}\\n🔗 ${e.link}`;\n});\n\nconst finalMessage = `📧 Email Digest — ${items.length} important email(s)\\n\\n${blocks.join('\\n\\n')}`;\n\nreturn [{ json: { finalMessage } }];\n"
      },
