    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Runs once per email (from either mailbox, after the merge).\n//\n// 2026-09-16: model moved to qwen3.5:9b (think:false) and the prompt now ships\n// worked examples as real user/assistant turns. Described rules alone let a small\n// model drift - marketing mail using urgent wording (\"Last chance!\") is the\n// classic failure - while a demonstrated answer is copied reliably.\nconst row = $json;\n\nconst SYS = `You are an email triage assistant for a personal inbox. You will be given ONE email's sender, subject, and a short preview/snippet. Score how important it is for the recipient to actually read it, on a 0-10 scale, and classify it into exactly one category.\n\nCategories: health, security, financial, work, personal, scheduling, promotional, newsletter, other.\n\nScoring guidance:\n- 8-10: health/medical results or messages (e.g. lab/diagnostic results, doctor messages, prescription notices), security alerts (login/password/breach), urgent financial deadlines (overdue bills, fraud alerts), time-critical personal/family messages, job interviews.\n- 5-7: work items needing action, appointment confirmations/reminders, non-urgent bills, moderately important personal correspondence.\n- 2-4: informational updates, receipts, low-urgency notifications.\n- 0-1: promotional/marketing emails, sales, newsletters, social-media notifications, spam.\n\nAlways score health results and security alerts high (8+) and promotional/marketing/newsletter content low (0-2), even if the subject line uses urgent-sounding marketing language (\"Last chance!\", \"Sale ends today\", \"24 hours left\").\n\nThe \"summary\" must describe THIS email. Never repeat these instructions, the category list or the scoring bands as the summary.\n\nRespond with ONLY valid JSON, no other text, in exactly this shape:\n{\"score\": <integer 0-10>, \"category\": \"<one category from the list above>\", \"urgent\": <true or false>, \"summary\": \"<one or two plain sentences on what the email is about and why it matters, or why it doesn't>\"}`;\n\n// Worked examples: retail urgency must not beat a real alert, and genuine\n// health/security mail must clear the notification threshold.\nconst SHOTS = [\n  [\n    'From: Old Navy <deals@oldnavy.com>\\nSubject: ⏰ LAST CHANCE! 60% off ends in 24 hours\\nPreview: Final hours to save on the Big Fall Sale. Shop now before it is gone.',\n    '{\"score\": 0, \"category\": \"promotional\", \"urgent\": false, \"summary\": \"Retail sale promotion using countdown wording. No action needed.\"}',\n  ],\n  [\n    'From: MyChart <no-reply@mychart.com>\\nSubject: New lab results available\\nPreview: Your recent bloodwork results have been released by Dr. Patel and are ready to view in MyChart.',\n    '{\"score\": 9, \"category\": \"health\", \"urgent\": true, \"summary\": \"Lab results from Dr. Patel have been released and are waiting to be reviewed in MyChart.\"}',\n  ],\n  [\n    'From: GitHub <noreply@github.com>\\nSubject: A new sign-in to your account from Chrome on Windows\\nPreview: We noticed a new sign-in to your GitHub account from an unrecognised device in Frankfurt, DE.',\n    '{\"score\": 9, \"category\": \"security\", \"urgent\": true, \"summary\": \"GitHub reports a sign-in from an unrecognised device in Frankfurt; verify it was you and rotate credentials if not.\"}',\n  ],\n];\n\nconst USER = `From: ${row.From || 'Unknown'}\\nSubject: ${row.Subject|| '(No Subject)'}\\nPreview: ${row.snippet || '(no preview available)'}`;\n\nconst idx = row.mailboxIndex !== undefined ? row.mailboxIndex : 0;\nconst id = row.id || '';\n\nconst shotMessages = SHOTS.flatMap(([u, a]) => [\n  { role: 'user', content: u },\n  { role: 'assistant', content: a },\n]);\n\nreturn {\n  id,\n  mailboxIndex: idx,\n  from: row.From || 'Unknown',\n  subject: row.Subject || '(No Subject)',\n  snippet: row.snippet || '',\n  link: id ? `https://mail.google.com/mail/u/${idx}/#all/${id}` : '',\n  messages: [\n    { role: 'system', content: SYS },\n    ...shotMessages,\n    { role: 'user', content: USER },\n  ],\n};\n"
      },
      "id": "e2591087-dcf9-4a9a-8367-65fb8612caf3",
      "name": "Prep item",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        384,
        80
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const prep = $('Prep item').item.json;\nconst resp = $json || {};\n\nlet raw = '';\nif (resp.message && resp.message.content) {\n  // Native Ollama /api/chat response\n  raw = String(resp.message.content || '');\n} else if (resp.choices && resp.choices[0] && resp.choices[0].message) {\n  // OpenAI-compatible /v1/chat/completions response\n  raw = String(resp.choices[0].message.content || '');\n} else if (resp.response) {\n  // Native Ollama /api/generate response\n  raw = String(resp.response || '');\n}\n\nfunction parseScore(text) {\n  const match = text.match(/\\{[\\s\\S]*\\}/);\n  if (!match) return null;\n  try {\n    return JSON.parse(match[0]);\n  } catch (e) {\n    return null;\n  }\n}\n\nconst parsed = parseScore(raw) || {};\nconst score = Number.isFinite(Number(parsed.score)) ? Math.max(0, Math.min(10, Number(parsed.score))) : 5;\n\n// Categories are a fixed list; anything else is 'other' rather than a new\n// category silently entering the email_digest table and the Gotify message.\nconst CATEGORIES = ['health', 'security', 'financial', 'work', 'personal', 'scheduling', 'promotional', 'newsletter', 'other'];\nlet category = typeof parsed.category === 'string' ? parsed.category.trim().toLowerCase() : 'other';\nif (!CATEGORIES.includes(category)) category = 'other';\n\nconst urgent = parsed.urgent === true;\nlet summary = typeof parsed.summary === 'string' && parsed.summary.trim()\n  ? parsed.summary.trim()\n  : (raw ? raw.slice(0, 200) : '(Model did not return a usable summary)');\n\n// Echo guard: if the model parroted the prompt instead of describing the email,\n// the verdict is unreliable. The score is deliberately NOT capped here - an\n// unreadable summary is no reason to risk hiding a genuine health or security\n// mail - but it is marked so it is obvious in the digest and the table.\nconst RUBRIC_ECHO = /score how important|scoring guidance|one category from the list|health, security, financial, work|last chance!, sale ends today/i;\nif (RUBRIC_ECHO.test(summary)) {\n  summary = `[unverified] ${summary}`.slice(0, 400);\n}\n\nconst THRESHOLD = 4;\n\nreturn {\n  id: prep.id,\n  mailboxIndex: prep.mailboxIndex,\n  from: prep.from,\n  subject: prep.subject,\n  link: prep.link,\n  category,\n  score,\n  urgent,\n  summary,\n  notified: score >= THRESHOLD,\n};"
      },
