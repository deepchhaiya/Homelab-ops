          "id": "sclY6NTkAb7qJnGp",
          "name": "Hermes Key"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const prep = $('Prep item').item.json;\nconst resp = $json || {};\n\nlet raw = '';\nif (resp.choices && resp.choices[0] && resp.choices[0].message) {\n  raw = String(resp.choices[0].message.content || '');\n}\n\nfunction parseScore(text) {\n  const match = text.match(/\\{[\\s\\S]*\\}/);\n  if (!match) return null;\n  try {\n    return JSON.parse(match[0]);\n  } catch (e) {\n    return null;\n  }\n}\n\nconst parsed = parseScore(raw) || {};\nconst score = Number.isFinite(Number(parsed.score)) ? Math.max(0, Math.min(10, Number(parsed.score))) : 5;\nconst category = typeof parsed.category === 'string' ? parsed.category.toLowerCase() : 'other';\nconst urgent = parsed.urgent === true;\nconst summary = typeof parsed.summary === 'string' && parsed.summary.trim()\n  ? parsed.summary.trim()\n  : (raw ? raw.slice(0, 200) : '(Hermes did not return a usable summary)');\n\nconst THRESHOLD = 4;\n\nreturn {\n  id: prep.id,\n  mailboxIndex: prep.mailboxIndex,\n  from: prep.from,\n  subject: prep.subject,\n  link: prep.link,\n  category,\n  score,\n  urgent,\n  summary,\n  notified: score >= THRESHOLD,\n};\n"
      },
