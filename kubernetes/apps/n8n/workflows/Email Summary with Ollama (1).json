      "id": "7cc51823-647a-41bc-9305-e48aef21d976",
      "name": "Hermes score email",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        640,
        80
      ],
      "alwaysOutputData": true,
      "credentials": {
