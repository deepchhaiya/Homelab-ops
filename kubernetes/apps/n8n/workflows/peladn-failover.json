    {
      "parameters": {
        "url": "https://prop.dkghar.duckdns.org/api2/json/version",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "allowUnauthorizedCerts": true,
          "timeout": 10000
