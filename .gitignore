# Plaintext secrets - NEVER commit these
.env
*.cleaned.env

# Encrypted secrets are safe to commit
# !*.env.enc.yaml

*.log
**/migrate-homeops-to-ssd.sh
**/audit.sh

# K8s plaintext secrets - NEVER commit these
**/secret.yaml
**/secrets.yaml

# Talos plaintext configs - NEVER commit these
talos-config
controlplane.yaml
worker.yaml
kubeconfig

# mem0 personal intelligence model - contains personal context, use template instead
docker/mem0-server/Modelfile
docker/mem0-server/personal-context.txt

# Local environment overrides
cluster.env
# macOS
.DS_Store
**/.DS_Store

